# ── Database (NEW database for v2 — do not point at the old July/live DB) ──
# Local Postgres from docker-compose.yml:
DATABASE_URL="postgresql://stratega:stratega@localhost:5432/stratega"

# ── Public site URL (used for canonical links, sitemap, hreflang) ──
NEXT_PUBLIC_SITE_URL="https://www.stratega.uz"

# ── Admin panel ──
# Shared emergency password (logs in as OWNER). Use a long random value.
ADMIN_PASSWORD=""
# Random string, at least 32 characters: `openssl rand -hex 32`
ADMIN_SESSION_SECRET=""

# Owner employee account created by `npm run db:seed`
SEED_OWNER_EMAIL="info@stratega.uz"
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Paxlavon Nekov"

# ── Optional integrations ──
# Product photos. On Vercel: set BLOB_READ_WRITE_TOKEN (Vercel Blob).
# On your own server (VPS): set LOCAL_UPLOADS="1" — files are kept in ./uploads (back this folder up).
# In development (npm run dev) photos are saved to ./uploads automatically.
BLOB_READ_WRITE_TOKEN=""
LOCAL_UPLOADS=""
# SMS login codes for customer cabinet (eskiz.uz)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
# AI chat widget (Groq). Without it the chat replies "not configured yet".
GROQ_API_KEY=""

# Telegram shop bot. Keep the bot token and webhook secret server-side.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Personal chat ID or an existing seller group chat ID.
TELEGRAM_SELLER_CHAT_ID=""
# Public customer-facing bot URL, e.g. https://t.me/YourStrategaBot
NEXT_PUBLIC_TELEGRAM_BOT_URL=""
# Optional second bot for staff only (commands, request buttons, admin Mini App, sales-chat notifications).
# Its webhook is /api/telegram/admin-webhook with its own secret.
TELEGRAM_ADMIN_BOT_TOKEN=""
TELEGRAM_ADMIN_WEBHOOK_SECRET=""

# ── Only for the one-time move from Website 2 (see README §4) ──
# SOURCE_DATABASE_URL=""

# Web analytics: the live counters are built in (src/lib/web-analytics.ts) and run only on stratega.uz.
# Set these only to override them (they then work on any host).
# Yandex Metrica counter number, e.g. 98765432
NEXT_PUBLIC_YM_ID=""
# Metrica session recordings (Webvisor): "1" to enable
NEXT_PUBLIC_YM_WEBVISOR=""
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_ID=""

# Vercel Cron: evening Telegram report (/api/cron/daily-report). Any long random string.
CRON_SECRET=""
